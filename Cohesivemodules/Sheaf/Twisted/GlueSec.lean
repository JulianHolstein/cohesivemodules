import Cohesivemodules.Sheaf.Twisted.SecRes

set_option linter.style.header false

/-!
# Z3.k: gluing sections of sheaves on an over-site

Blueprint item Z3.k (`blueprint/blueprint-tw.md` §3 C.7 (a)). For a sheaf of modules `P` on the
over-site `Over U` and an open cover `V i` of `W ≤ U`, compatible sections over the `V i` glue to
a unique section over `W` (the sheaf condition for the sieve generated by the cover; pullbacks in
`Over U` are intersections).
-/

noncomputable section

namespace Cohesive

open CategoryTheory TopologicalSpace Opposite

variable {X : Type} [TopologicalSpace X] {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{0}}

/-- The sieve on `Over.mk (W ≤ U)` of morphisms landing in some member of the cover. -/
private def coverSieve {U W : Opens X} (hW : W ≤ U) {κ : Type} (V : κ → Opens X) :
    Sieve (Over.mk (homOfLE hW)) :=
  (Sieve.overEquiv (Over.mk (homOfLE hW))).symm
    { arrows := fun Z _ => ∃ i, Z ≤ V i
      downward_closed := by
        rintro Z Z' f ⟨i, hi⟩ g
        exact ⟨i, (leOfHom g).trans hi⟩ }

/-- The cover sieve is covering in the over-site. -/
private lemma coverSieve_mem {U W : Opens X} (hW : W ≤ U) {κ : Type} (V : κ → Opens X)
    (hcov : W ≤ ⨆ i, V i) :
    coverSieve hW V ∈ ((Opens.grothendieckTopology X).over U) (Over.mk (homOfLE hW)) := by
  refine GrothendieckTopology.overEquiv_symm_mem_over _ (Over.mk (homOfLE hW)) _ ?_
  intro y hy
  obtain ⟨i, hi⟩ := Opens.mem_iSup.1 (hcov hy)
  exact ⟨W ⊓ V i, homOfLE inf_le_left, ⟨i, inf_le_right⟩, hy, hi⟩

/-- A morphism in the cover sieve factors through restriction to a member of the cover. -/
private lemma map_eq_of_le {U W V' : Opens X} (P : Mod ((ringOf R).over U)) (hW : W ≤ U)
    (hV : V' ≤ W) (Z : Over U) (f : Z ⟶ Over.mk (homOfLE hW)) (hz : Z.left ≤ V')
    (x : sec R P hW) :
    (P.val.map f.op).hom x =
      (P.val.map (Over.homMk (homOfLE hz) (Subsingleton.elim _ _) :
        Z ⟶ Over.mk (homOfLE (hV.trans hW))).op).hom (secRes R P hW hV x) := by
  have e : f = (Over.homMk (homOfLE hz) (Subsingleton.elim _ _) :
        Z ⟶ Over.mk (homOfLE (hV.trans hW))) ≫
      (Over.homMk (homOfLE hV) : Over.mk (homOfLE (hV.trans hW)) ⟶ Over.mk (homOfLE hW)) :=
    Over.OverMorphism.ext (Subsingleton.elim _ _)
  unfold secRes
  rw [e, op_comp]
  exact PresheafOfModules.map_comp_apply _ _ _ _

/-- **Z3.k (a).** Sections of a sheaf on `Over U` over `W ≤ U` are determined by their
restrictions to the members of an open cover of `W`. -/
theorem sec_ext_of_cover {U W : Opens X} (hW : W ≤ U) (P : Mod ((ringOf R).over U)) {κ : Type}
    (V : κ → Opens X) (hV : ∀ i, V i ≤ W) (hcov : W ≤ ⨆ i, V i) (t t' : sec R P hW)
    (h : ∀ i, secRes R P hW (hV i) t = secRes R P hW (hV i) t') : t = t' := by
  refine Presheaf.IsSheaf.isSeparated P.isSheaf (Over.mk (homOfLE hW)) _
    (coverSieve_mem hW V hcov) t t' ?_
  intro Z f hf
  obtain ⟨i, hi⟩ := (Sieve.overEquiv_symm_iff _ f).1 hf
  exact (map_eq_of_le P hW (hV i) Z f hi t).trans
    ((congrArg _ (h i)).trans (map_eq_of_le P hW (hV i) Z f hi t').symm)

/-- **Z3.k (a).** [Stacks 00VR]. Compatible sections of a sheaf on `Over U` over the members `V i`
of an open cover of `W ≤ U` glue to a unique section over `W`. Compatibility is equality of the
restrictions to `V i ⊓ V j`. -/
theorem sec_existsUnique_gluing {U W : Opens X} (hW : W ≤ U) (P : Mod ((ringOf R).over U))
    {κ : Type} (V : κ → Opens X) (hV : ∀ i, V i ≤ W) (hcov : W ≤ ⨆ i, V i)
    (s : ∀ i, sec R P ((hV i).trans hW))
    (hs : ∀ i j, secRes R P ((hV i).trans hW) (inf_le_left : V i ⊓ V j ≤ V i) (s i) =
      secRes R P ((hV j).trans hW) (inf_le_right : V i ⊓ V j ≤ V j) (s j)) :
    ∃! t : sec R P hW, ∀ i, secRes R P hW (hV i) t = s i := by
  have hT : Presieve.IsSheaf ((Opens.grothendieckTopology X).over U)
      (P.val.presheaf ⋙ forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      ((sheafCompose ((Opens.grothendieckTopology X).over U) (forget AddCommGrpCat)).obj
        ⟨_, P.isSheaf⟩).2
  let π : ∀ i, Over.mk (homOfLE ((hV i).trans hW)) ⟶ Over.mk (homOfLE hW) :=
    fun i => Over.homMk (homOfLE (hV i))
  have hgen : Sieve.generate (Presieve.ofArrows (fun i => Over.mk (homOfLE ((hV i).trans hW)))
      π) ∈ ((Opens.grothendieckTopology X).over U) (Over.mk (homOfLE hW)) := by
    refine GrothendieckTopology.superset_covering _ ?_ (coverSieve_mem hW V hcov)
    intro Z f hf
    obtain ⟨i, hi⟩ := (Sieve.overEquiv_symm_iff _ f).1 hf
    exact ⟨_, Over.homMk (homOfLE hi) (Subsingleton.elim _ _), π i, Presieve.ofArrows.mk i,
      Over.OverMorphism.ext (Subsingleton.elim _ _)⟩
  have hS := (Presieve.isSheafFor_arrows_iff _ π).1 (hT.isSheafFor _ hgen)
  obtain ⟨t, ht, ht'⟩ := hS (fun i => s i) (by
    intro i j Z gi gj _
    have hz : Z.left ≤ V i ⊓ V j :=
      le_inf (leOfHom gi.left : Z.left ≤ V i) (leOfHom gj.left : Z.left ≤ V j)
    have e1 := map_eq_of_le P ((hV i).trans hW) (inf_le_left : V i ⊓ V j ≤ V i) Z gi hz (s i)
    have e2 := map_eq_of_le P ((hV j).trans hW) (inf_le_right : V i ⊓ V j ≤ V j) Z gj hz (s j)
    exact e1.trans ((congrArg _ (hs i j)).trans e2.symm))
  exact ⟨t, ht, fun t' ht'' => ht' t' ht''⟩

end Cohesive
