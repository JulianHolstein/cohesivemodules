/-!
# S10: globalization over a fine sheaf (part 2 of 2)

Split from `Sheaf/Globalize.lean` for size; continues `Sheaf/GlobalizeEpi.lean`.
-/

noncomputable section
namespace Cohesive
open CategoryTheory Opposite TopologicalSpace Limits
section Space
variable {X : Type} [TopologicalSpace X] {R : RingSheaf X}

/-- Homotopic maps: quasi-isomorphism transfers. -/
private lemma quasiIso_of_homotopy {C' : Type*} [Category C'] [Abelian C']
    {K L : CochainComplex C' ℤ} {f g : K ⟶ L} (h : Homotopy f g) [QuasiIso g] : QuasiIso f := by
  rw [quasiIso_iff]
  intro i
  rw [quasiIsoAt_iff_isIso_homologyMap]
  rw [Homotopy.homologyMap_eq h i]
  exact (quasiIsoAt_iff_isIso_homologyMap g i).1 inferInstance

/-- Strict perfection of the truncation `τ_{≥a} F` of a finite free complex whose
`B = F^a / d F^{a-1}` is a summand of a finite free module. -/
private lemma strictlyPerfect_truncGE {F : CochainComplex (Mod R) ℤ} (a b : ℤ)
    [F.IsStrictlyLE b] (hF : ∀ i, IsFinFreeSummand (F.X i))
    (hB : IsFinFreeSummand (F.opcycles a)) : IsStrictlyPerfect (F.truncGE a) := by
  refine ⟨⟨a, b, inferInstance, ?_⟩, fun n => ?_⟩
  · rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    rcases lt_trichotomy i a with h | h | h
    · exact (F.truncGE a).isZero_of_isStrictlyGE a i h
    · subst h
      have hz : IsZero (F.X i) := F.isZero_of_isStrictlyLE b i hi
      exact IsZero.of_iso (IsZero.of_epi (F.pOpcycles i) hz)
        (F.truncGEXIsoOpcycles i)
    · exact IsZero.of_iso (F.isZero_of_isStrictlyLE b i hi) (F.truncGEXIso a i h)
  · rcases lt_trichotomy n a with h | h | h
    · exact ⟨0, 0, 0, ((F.truncGE a).isZero_of_isStrictlyGE a n h).eq_of_src _ _⟩
    · subst h
      obtain ⟨m, i, p, hip⟩ := hB
      let e := F.truncGEXIsoOpcycles n
      exact ⟨m, e.hom ≫ i, p ≫ e.inv, by
        rw [Category.assoc, ← Category.assoc i, hip, Category.id_comp, e.hom_inv_id]⟩
    · obtain ⟨m, i, p, hip⟩ := hF n
      let e := F.truncGEXIso a n h
      exact ⟨m, e.hom ≫ i, p ≫ e.inv, by
        rw [Category.assoc, ← Category.assoc i, hip, Category.id_comp, e.hom_inv_id]⟩

/-- Assembly: `P = τ_{≥a} F` is strictly perfect, K-projective, and `P ⟶ τ_{≥a} K ← K` lifts. -/
private lemma assemble [CompactSpace X] (hR : IsFine R) {K F : CochainComplex (Mod R) ℤ}
    (a b : ℤ) [F.IsStrictlyLE b] (hF : ∀ i, IsFinFreeSummand (F.X i))
    (hB : IsFinFreeSummand (F.opcycles a)) (φ : F ⟶ K) [K.IsGE a]
    (hφ : ∀ i, a ≤ i → QuasiIsoAt φ i) :
    ∃ (P : CochainComplex (Mod R) ℤ) (f : P ⟶ K), IsStrictlyPerfect P ∧ QuasiIso f := by
  have hP := strictlyPerfect_truncGE a b hF hB
  have hproj : ∀ n, Projective ((F.truncGE a).X n) := fun n =>
    projective_of_isFinFreeSummand hR (hP.2 n)
  have hP' := hP
  obtain ⟨⟨a', b', -, hb'⟩, -⟩ := hP'
  have hK : (F.truncGE a).IsKProjective := CochainComplex.isKProjective_of_projective _ b'
  have hq : QuasiIso (CochainComplex.truncGEMap φ a) :=
    (CochainComplex.quasiIso_truncGEMap_iff φ a).2 hφ
  let _ : HasDerivedCategory (Mod R) := HasDerivedCategory.standard _
  obtain ⟨f, ⟨ho⟩⟩ := exists_lift_of_isKProjective (P := F.truncGE a) (K := K.truncGE a)
    (L := K) (K.πTruncGE a) (CochainComplex.truncGEMap φ a)
  have : QuasiIso (f ≫ K.πTruncGE a) := quasiIso_of_homotopy ho
  exact ⟨F.truncGE a, f, hP, (quasiIso_iff_comp_right f (K.πTruncGE a)).1 this⟩

/-- The induction invariant of [TT 1.9.5]: `φ` is an isomorphism on `H^i` for `i > k` and onto
on `H^k` (equivalently the cone is exact in degrees `≥ k`). -/
private def Inv {K F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) (k : ℤ) : Prop :=
  (∀ i, k < i → QuasiIsoAt φ i) ∧ Epi (HomologicalComplex.homologyMap φ k)

/-- A covering of the terminal object of `Over U` generated by `Q` has a member around any
point of `U`. -/
private lemma exists_nbhd_of_over {U : Opens X} {Q : Over U → Prop}
    (hS : Sieve.generate (fun W (_ : W ⟶ Over.mk (𝟙 U)) ↦ Q W) ∈
      ((Opens.grothendieckTopology X).over U) (Over.mk (𝟙 U))) {x : X} (hx : x ∈ U) :
    ∃ W : Over U, x ∈ W.left ∧ Q W := by
  have hS' := (GrothendieckTopology.mem_over_iff _ _).1 hS
  obtain ⟨V, g, hg, hxV⟩ := (Opens.mem_grothendieckTopology X).1 hS' x hx
  rw [Sieve.overEquiv_iff] at hg
  obtain ⟨W', a', b', hW', -⟩ := hg
  exact ⟨W', leOfHom a'.left hxV, hW'⟩

/-- The cone of the restriction of `φ` to `U` has the same exactness. -/
private lemma exactAt_cone_over {K F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) (U : Opens X)
    (k : ℤ) (hex : ∀ i, k ≤ i → (CochainComplex.mappingCone φ).ExactAt i) :
    ∀ i, k ≤ i → (CochainComplex.mappingCone ((overC U).map φ)).ExactAt i := by
  intro i hi
  rw [HomologicalComplex.exactAt_iff_isZero_homology]
  have h0 := (HomologicalComplex.exactAt_iff_isZero_homology _ _).1 (hex i hi)
  exact IsZero.of_iso (Functor.map_isZero (SheafOfModules.overFunctor.{0} R U) h0)
    (coneOverHomologyIso φ U i)

/-- **S10, step 1a.** The homology sheaf `H^{k-1}` of the cone of `φ` is locally finitely generated
(local models, S10.b and S10.d). -/
private lemma local_fg {K : CochainComplex (Mod R) ℤ} {a b : ℤ} (hK : IsPerfectIn K a b)
    {F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) (k : ℤ) [F.IsStrictlyGE k] [F.IsStrictlyLE b]
    (hF : ∀ i, IsFinFreeSummand (F.X i))
    (hex : ∀ i, k ≤ i → (CochainComplex.mappingCone φ).ExactAt i) :
    ∀ x : X, ∃ U : Opens X, x ∈ U ∧ ∃ (m : ℕ)
      (π : SheafOfModules.free (R := R.over U) (Fin m) ⟶
        (restr R U).obj ((CochainComplex.mappingCone φ).homology (k - 1))), Epi π := by
  intro x
  obtain ⟨U, hxU, L, P, f, g, hf, hg, hP, ha, hb⟩ := hK x
  have hFp : IsStrictlyPerfect F := ⟨⟨k, b, inferInstance, inferInstance⟩, hF⟩
  have hS := local_fg_site (J := (Opens.grothendieckTopology X).over U) (R := R.over U) f g
    (strictlyPerfect_over hFp U) hP ((overC U).map φ) k (exactAt_cone_over φ U k hex)
    (Over.mk (𝟙 U))
  obtain ⟨W, hxW, m, π, hπ⟩ := exists_nbhd_of_over hS hxU
  obtain ⟨π', hπ'⟩ := exists_epi_free_transfer
    (M := (CochainComplex.mappingCone φ).homology (k - 1))
    (coneOverHomologyIso φ U (k - 1)) W m π hπ
  exact ⟨W.left, hxW, m, π', hπ'⟩

/-- The invariant gives exactness of the cone in degrees `≥ k`. -/
private lemma exactAt_of_inv {K F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) (k : ℤ)
    (hinv : Inv φ k) : ∀ i, k ≤ i → (CochainComplex.mappingCone φ).ExactAt i := by
  intro i hi
  have hepi : Epi (HomologicalComplex.homologyMap φ i) := by
    rcases eq_or_lt_of_le hi with rfl | hlt
    · exact hinv.2
    · have := hinv.1 i hlt
      rw [quasiIsoAt_iff_isIso_homologyMap] at this
      infer_instance
  have hmono : Mono (HomologicalComplex.homologyMap φ (i + 1)) := by
    have := hinv.1 (i + 1) (by omega)
    rw [quasiIsoAt_iff_isIso_homologyMap] at this
    infer_instance
  exact cone_exactAt_of φ i hepi hmono

/-- Exactness of the cone in degrees `≥ k` gives the invariant. -/
private lemma inv_of_exactAt {K F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) (k : ℤ)
    (hex : ∀ i, k ≤ i → (CochainComplex.mappingCone φ).ExactAt i) : Inv φ k := by
  refine ⟨fun i hi => ?_, cone_homology_epi φ k (hex k le_rfl)⟩
  rw [quasiIsoAt_iff_isIso_homologyMap]
  have := cone_homology_epi φ i (hex i hi.le)
  have := cone_homology_mono φ i (hex (i - 1) (by omega))
  exact isIso_of_mono_of_epi _

/-- **S10, step 1.** The inductive step of [TT 1.9.5]: extend a finite free approximation by one
free term in degree `k - 1`. -/
private lemma step_exists [CompactSpace X] (hR : IsFine R)
    {K : CochainComplex (Mod R) ℤ} {a b : ℤ} (hK : IsPerfectIn K a b)
    {F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) (k : ℤ) [F.IsStrictlyGE k] [F.IsStrictlyLE b]
    (hkb : k ≤ b + 1) (hF : ∀ i, IsFinFreeSummand (F.X i)) (hinv : Inv φ k) :
    ∃ (F' : CochainComplex (Mod R) ℤ) (φ' : F' ⟶ K), F'.IsStrictlyGE (k - 1) ∧
      F'.IsStrictlyLE b ∧ (∀ i, IsFinFreeSummand (F'.X i)) ∧ Inv φ' (k - 1) := by
  have hex := exactAt_of_inv φ k hinv
  obtain ⟨m, ε, hε⟩ := exists_epi_free_of_locally hR (local_fg hK φ k hF hex)
  have hproj := projective_free hR (Fin m)
  obtain ⟨ρ, hρ⟩ := Projective.factors ε
    ((CochainComplex.mappingCone φ).homologyπ (k - 1))
  have hρe : Epi (ρ ≫ (CochainComplex.mappingCone φ).homologyπ (k - 1)) := by
    rw [hρ]; exact hε
  obtain ⟨F', φ', hexF, hterms⟩ := step_construct φ k hex (SheafOfModules.free (Fin m)) ρ hρe
  have hfs : ∀ n, IsFinFreeSummand (F'.X n) := by
    intro n
    obtain ⟨G₀, hG₀, -, ⟨e⟩⟩ := hterms n
    have hG : IsFinFreeSummand G₀ := by
      rcases hG₀ with hz | ⟨⟨e'⟩⟩
      · exact ⟨0, 0, 0, hz.eq_of_src _ _⟩
      · exact isFinFreeSummand_of_retract e'.hom e'.inv e'.hom_inv_id ⟨m, 𝟙 _, 𝟙 _, by simp⟩
    exact isFinFreeSummand_of_retract e.hom e.inv e.hom_inv_id (isFinFreeSummand_biprod hG (hF n))
  refine ⟨F', φ', ?_, ?_, hfs, inv_of_exactAt φ' (k - 1) hexF⟩
  · rw [CochainComplex.isStrictlyGE_iff]
    intro n hn
    obtain ⟨G₀, -, hG₀, ⟨e⟩⟩ := hterms n
    refine IsZero.of_iso ?_ e
    rw [biprod_isZero_iff]
    exact ⟨hG₀ (by omega), F.isZero_of_isStrictlyGE k n (by omega)⟩
  · rw [CochainComplex.isStrictlyLE_iff]
    intro n hn
    obtain ⟨G₀, -, hG₀, ⟨e⟩⟩ := hterms n
    refine IsZero.of_iso ?_ e
    rw [biprod_isZero_iff]
    exact ⟨hG₀ (by omega), F.isZero_of_isStrictlyLE b n hn⟩

/-- **S10, step 3.** `B = F^a / d F^{a-1}` is locally a summand of a finite free module. -/
private lemma opcycles_locally {K : CochainComplex (Mod R) ℤ} {a b : ℤ} (hK : IsPerfectIn K a b)
    {F : CochainComplex (Mod R) ℤ} (φ : F ⟶ K) [F.IsStrictlyGE (a - 1)] [F.IsStrictlyLE b]
    (hF : ∀ i, IsFinFreeSummand (F.X i)) (hinv : Inv φ (a - 1)) :
    IsLocallyFinFreeSummand (F.opcycles a) := by
  intro x
  obtain ⟨U, hxU, L, P, f, g, hf, hg, hP, ha, hb⟩ := hK x
  have hFp : IsStrictlyPerfect F := ⟨⟨a - 1, b, inferInstance, inferInstance⟩, hF⟩
  have hex := exactAt_of_inv φ (a - 1) hinv
  have hS := opcycles_site (J := (Opens.grothendieckTopology X).over U) (R := R.over U) f g
    (strictlyPerfect_over hFp U) hP a b ((overC U).map φ) (exactAt_cone_over φ U (a - 1) hex)
    (Over.mk (𝟙 U))
  obtain ⟨W, hxW, hW⟩ := exists_nbhd_of_over hS hxU
  let ι := (F.sc a).mapOpcyclesIso (SheafOfModules.overFunctor.{0} R U)
  exact ⟨W.left, hxW, isFinFreeSummand_transfer (M := F.opcycles a) (Y := U)
    (N := ((overC U).obj F).opcycles a) ι.inv ι.hom ι.inv_hom_id W hW⟩

/-- **S10, step 2.** Iterating the step from degree `b + 1` down. -/
private lemma iter_exists [CompactSpace X] (hR : IsFine R)
    {K : CochainComplex (Mod R) ℤ} {a b : ℤ} (hK : IsPerfectIn K a b) (n : ℕ) :
    ∃ (F : CochainComplex (Mod R) ℤ) (φ : F ⟶ K), F.IsStrictlyGE (b + 1 - n) ∧
      F.IsStrictlyLE b ∧ (∀ i, IsFinFreeSummand (F.X i)) ∧ Inv φ (b + 1 - n) := by
  induction n with
  | zero =>
    obtain ⟨Z, hZ⟩ := (inferInstance : Limits.HasZeroObject (CochainComplex (Mod R) ℤ)).zero
    have hz : ∀ i, IsZero (Z.X i) := fun i =>
      Functor.map_isZero (HomologicalComplex.eval (Mod R) (ComplexShape.up ℤ) i) hZ
    refine ⟨Z, 0, ?_, ?_, fun i => ⟨0, 0, 0, (hz i).eq_of_src _ _⟩, ?_, ?_⟩
    · rw [CochainComplex.isStrictlyGE_iff]; exact fun i _ => hz i
    · rw [CochainComplex.isStrictlyLE_iff]; exact fun i _ => hz i
    · intro i hi
      have hZex : Z.ExactAt i := (HomologicalComplex.exactAt_iff_isZero_homology _ _).2
        (Functor.map_isZero (HomologicalComplex.homologyFunctor (Mod R) (ComplexShape.up ℤ) i) hZ)
      rw [quasiIsoAt_iff_exactAt _ i hZex]
      exact hK.exactAt i (Or.inr (by push_cast at hi; omega))
    · have hK1 : K.ExactAt (b + 1 - ((0 : ℕ) : ℤ)) := hK.exactAt _ (Or.inr (by push_cast; omega))
      have := (HomologicalComplex.exactAt_iff_isZero_homology _ _).1 hK1
      exact this.epi _
  | succ n ih =>
    obtain ⟨F, φ, h1, h2, h3, h4⟩ := ih
    have := h1
    have := h2
    obtain ⟨F', φ', h1', h2', h3', h4'⟩ := step_exists hR hK φ (b + 1 - n) (by omega) h3 h4
    have e : b + 1 - ((n + 1 : ℕ) : ℤ) = b + 1 - n - 1 := by push_cast; ring
    rw [e]
    exact ⟨F', φ', h1', h2', h3', h4'⟩

/-- Weakening the lower bound of a globally bounded perfect complex. -/
private lemma IsPerfectIn.mono_left {K : CochainComplex (Mod R) ℤ} {a b : ℤ} (a₁ : ℤ)
    (h : a₁ ≤ a) (hK : IsPerfectIn K a b) : IsPerfectIn K a₁ b := by
  intro x
  obtain ⟨U, hU, L, P, f, g, hf, hg, hP, ha, hb⟩ := hK x
  exact ⟨U, hU, L, P, f, g, hf, hg, hP, P.isStrictlyGE_of_ge a₁ a h, hb⟩

/-- **S10. Globalization over a fine sheaf.** For `R` fine and commutative on compact `X`, every
perfect complex `K` of `R`-modules receives a quasi-isomorphism from a strictly perfect complex.
[A, Lemma 7.2.16], [TT, Lemma 1.9.5]. Proof (blueprint v1.8): by S9.d, `K` has local models in
`[a, b]` and homology in `[a, b]`. (1) Downward induction from `b` to `a - 1` builds finite free
`Fⁿ` and `F → K`, iso on homology above the current degree, as in [TT, Lemma 1.9.5]: the next
homology sheaf of the cone is locally the top homology of the cone of a local lift `F|U → P_U`
(S10.b), so locally finitely generated (S10.d), hence a quotient of a finite free module (S10.e);
lift to cycles (S4.a). (2) `B = coker(F^{a-1} → F^a)`, `P = (B → F^{a+1} → ⋯ → F^b) → τ_{≥a}K ≃ K`.
Locally the model lifts to a quasi-isomorphism `P_U → P|U` (S10.b) whose cone splits locally
(S10.c), so `B` is locally, and by S4.b globally, a summand of a finite free module; `P` is
strictly perfect, K-projective (S4.a, S11), and `P → τ_{≥a}K` lifts to `P → K` (S11). -/
theorem exists_strictlyPerfect_quasiIso [CompactSpace X] (hR : IsFine R) (hc : IsComm R)
    {K : CochainComplex (Mod R) ℤ} (hK : IsPerfect K) :
    ∃ (P : CochainComplex (Mod R) ℤ) (f : P ⟶ K), IsStrictlyPerfect P ∧ QuasiIso f := by
  obtain ⟨a, b, hab⟩ := hK.exists_isPerfectIn
  have hab' : IsPerfectIn K (min a (b + 1)) b := hab.mono_left _ (min_le_left _ _)
  set a₁ := min a (b + 1) with ha₁
  have hle : a₁ ≤ b + 1 := min_le_right _ _
  obtain ⟨F, φ, h1, h2, h3, h4⟩ := iter_exists hR hab' (b + 1 - (a₁ - 1)).toNat
  have e : b + 1 - (((b + 1 - (a₁ - 1)).toNat : ℕ) : ℤ) = a₁ - 1 := by omega
  rw [e] at h1 h4
  have hBloc := opcycles_locally hab' φ h3 h4
  have hB := isFinFreeSummand_of_locally hR hc hBloc
  have hKGE : K.IsGE a₁ := by
    rw [CochainComplex.isGE_iff]
    exact fun i hi => hab'.exactAt i (Or.inl hi)
  exact assemble hR a₁ b h3 hB φ (fun i hi => h4.1 i (by omega))

end Space

end Cohesive
