import Cohesivemodules.Sheaf.Globalize.Locally

set_option linter.style.header false

/-!
# S10 (part 4): local approximation of a perfect complex on a site

Blueprint item S10 (§3). Split from `Sheaf/Globalize.lean` for size only (CLAUDE.md: "New work
goes in small new files"); no mathematical change.

The local steps of the globalization on a site: restriction of strictly perfect complexes and
cones to over-sites, local approximation of a complex by a strictly perfect one, local finite
generation of the relevant homology, and the opcycles of truncations.
-/

noncomputable section

namespace Cohesive

open CategoryTheory Opposite TopologicalSpace Limits

section Site

variable {C : Type} [SmallCategory C] {J : GrothendieckTopology C}
  [HasWeakSheafify J AddCommGrpCat.{0}] [J.WEqualsLocallyBijective AddCommGrpCat.{0}]
  {R : Sheaf J RingCat.{0}}

/-- From a local statement at the objects of a covering sieve to one on the sieve generated by
the property `Q`. -/
private lemma generate_of_local {X : C} {P Q : C → Prop}
    (hS : Sieve.generate (fun Z (_ : Z ⟶ X) ↦ P Z) ∈ J X)
    (hP : ∀ Z, P Z → Sieve.generate (fun V (_ : V ⟶ Z) ↦ Q V) ∈ J Z) :
    Sieve.generate (fun V (_ : V ⟶ X) ↦ Q V) ∈ J X := by
  refine J.transitive hS _ (fun Y h hh => ?_)
  obtain ⟨Z, a, b, hb, rfl⟩ := hh
  refine J.superset_covering ?_ (J.pullback_stable a (hP Z hb))
  intro V v hv
  obtain ⟨V', c, d, hQ, hcd⟩ := hv
  exact ⟨V', c, d ≫ b, hQ, by rw [← Category.assoc, hcd, Category.assoc]⟩

/-- Restriction to an over-site is a left adjoint when `C` has binary products. -/
private instance ovL [HasBinaryProducts C] (Y : C) :
    (SheafOfModules.overFunctor.{0} R Y).IsLeftAdjoint :=
  inferInstanceAs (SheafOfModules.pushforward.{0} (𝟙 (R.over Y))).IsLeftAdjoint

/-- Restriction to an over-site is strictly perfect on strictly perfect complexes. -/
lemma strictlyPerfect_over {E : CochainComplex (Mod R) ℤ} (hE : IsStrictlyPerfect E)
    (Y : C) : IsStrictlyPerfect ((overC Y).obj E) := by
  obtain ⟨⟨a, b, ha, hb⟩, hf⟩ := hE
  refine ⟨⟨a, b, ?_, ?_⟩, fun n => (FS.of_global (hf n) Y).isFinFreeSummand⟩
  · rw [CochainComplex.isStrictlyGE_iff]
    exact fun i hi => Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y)
      (E.isZero_of_isStrictlyGE a i hi)
  · rw [CochainComplex.isStrictlyLE_iff]
    exact fun i hi => Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y)
      (E.isZero_of_isStrictlyLE b i hi)

/-- The cone of a map between strictly perfect complexes is strictly perfect. -/
private lemma strictlyPerfect_cone {E P : CochainComplex (Mod R) ℤ} (hE : IsStrictlyPerfect E)
    (hP : IsStrictlyPerfect P) (χ : E ⟶ P) : IsStrictlyPerfect (CochainComplex.mappingCone χ) := by
  obtain ⟨⟨a, b, ha, hb⟩, hf⟩ := hE
  obtain ⟨⟨a', b', ha', hb'⟩, hf'⟩ := hP
  refine ⟨⟨min (a - 1) a', max b b', ?_, ?_⟩, fun n => ?_⟩
  · rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    rw [CochainComplex.mappingCone.isZero_X_iff]
    exact ⟨E.isZero_of_isStrictlyGE a (i + 1) (by omega),
      P.isZero_of_isStrictlyGE a' i (by omega)⟩
  · rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    rw [CochainComplex.mappingCone.isZero_X_iff]
    exact ⟨E.isZero_of_isStrictlyLE b (i + 1) (by omega),
      P.isZero_of_isStrictlyLE b' i (by omega)⟩
  · let e := HomologicalComplex.homotopyCofiber.XIsoBiprod χ n (n + 1) rfl
    exact isFinFreeSummand_of_retract e.hom e.inv e.hom_inv_id
      (isFinFreeSummand_biprod (hf (n + 1)) (hf' n))

/-- Homology of the cone of a restricted map is the restriction of the homology of the cone. -/
noncomputable def coneOverHomologyIso [HasBinaryProducts C] {F K : CochainComplex (Mod R) ℤ}
    (φ : F ⟶ K) (Y : C) (i : ℤ) :
    (CochainComplex.mappingCone ((overC Y).map φ)).homology i ≅
      ((CochainComplex.mappingCone φ).homology i).over Y :=
  (HomologicalComplex.homologyFunctor _ (ComplexShape.up ℤ) i).mapIso
      (CochainComplex.mappingCone.mapHomologicalComplexIso φ
        (SheafOfModules.overFunctor.{0} R Y)).symm ≪≫
    ((CochainComplex.mappingCone φ).sc i).mapHomologyIso (SheafOfModules.overFunctor.{0} R Y)


/-- **Local approximation.** Given a roof `K ← L → P` of quasi-isomorphisms with `P` strictly
perfect and a strictly perfect `F` with `φ : F ⟶ K`, locally `φ` is approximated by a map
`χ : F|Y ⟶ P|Y` whose cone has the homology of the cone of `φ|Y`. -/
private lemma local_approx [HasBinaryProducts C] {K L P F : CochainComplex (Mod R) ℤ}
    (f : L ⟶ K) (g : L ⟶ P) [QuasiIso f] [QuasiIso g] (hF : IsStrictlyPerfect F) (φ : F ⟶ K)
    (X : C) :
    Sieve.generate (fun Y (_ : Y ⟶ X) ↦ ∃ χ : (overC Y).obj F ⟶ (overC Y).obj P,
      ∀ i, Nonempty (((CochainComplex.mappingCone χ).homology i) ≅
        (((CochainComplex.mappingCone φ).homology i).over Y))) ∈ J X := by
  refine J.superset_covering ((Sieve.generate_le_iff _ _).2 fun Y h hh => ?_)
    (lift_fill hF f φ X)
  obtain ⟨g', ⟨ho⟩⟩ := hh
  refine Sieve.le_generate _ Y h ⟨g' ≫ (overC Y).map g, fun i => ?_⟩
  obtain ⟨e⟩ := cone_homology_iso_four g' ((overC Y).map φ) ((overC Y).map f) ((overC Y).map g)
    ho i
  exact ⟨e.symm ≪≫ coneOverHomologyIso φ Y i⟩


/-- Transfer of a finite free summand through the nested restriction. -/
lemma isFinFreeSummand_transfer {M : Mod R} {Y : C} {N : Mod (R.over Y)}
    (s : M.over Y ⟶ N) (r : N ⟶ M.over Y) (hsr : s ≫ r = 𝟙 _) (W : Over Y)
    (hN : IsFinFreeSummand (N.over W)) : IsFinFreeSummand (M.over W.left) := by
  have h1 : IsFinFreeSummand ((M.over Y).over W) :=
    isFinFreeSummand_of_retract ((SheafOfModules.overFunctor.{0} (R.over Y) W).map s)
      ((SheafOfModules.overFunctor.{0} (R.over Y) W).map r)
      (by rw [← CategoryTheory.Functor.map_comp, hsr, CategoryTheory.Functor.map_id]) hN
  have h2 := (isFinFreeSummand_overOverEquiv_iff Y W ((M.over Y).over W)).2 h1
  let e₂ := overOverEquivObjIso (R := R) Y W M
  exact isFinFreeSummand_of_retract e₂.inv e₂.hom e₂.inv_hom_id h2

/-- Transfer of a finite free presentation through the nested restriction. -/
lemma exists_epi_free_transfer {M : Mod R} {Y : C} {N : Mod (R.over Y)}
    (ι : N ≅ M.over Y) (W : Over Y) (m : ℕ)
    (π : SheafOfModules.free (R := (R.over Y).over W) (Fin m) ⟶ N.over W) (hπ : Epi π) :
    ∃ π' : SheafOfModules.free (R := R.over W.left) (Fin m) ⟶ M.over W.left, Epi π' := by
  let e := overOverEquiv (R := R) Y W
  let η := SheafOfModules.mapFreeIso e.functor (Fin m) (overOverUnit (R := R) Y W)
  let e₁ : N.over W ≅ (M.over Y).over W := (SheafOfModules.overFunctor.{0} (R.over Y) W).mapIso ι
  let e₂ := overOverEquivObjIso (R := R) Y W M
  refine ⟨η.hom ≫ e.functor.map (π ≫ e₁.hom) ≫ e₂.hom, ?_⟩
  have : Epi (π ≫ e₁.hom) := epi_comp _ _
  infer_instance


/-- **Gen1.** The homology of the cone of `φ` is locally finitely generated, given a global roof
`K ← L → P` with `P` strictly perfect. -/
lemma local_fg_site [HasBinaryProducts C] {K L P F : CochainComplex (Mod R) ℤ}
    (f : L ⟶ K) (g : L ⟶ P) [QuasiIso f] [QuasiIso g] (hF : IsStrictlyPerfect F)
    (hP : IsStrictlyPerfect P) (φ : F ⟶ K) (k : ℤ)
    (hex : ∀ i, k ≤ i → (CochainComplex.mappingCone φ).ExactAt i) (X : C) :
    Sieve.generate (fun Y (_ : Y ⟶ X) ↦ ∃ (m : ℕ)
      (π : SheafOfModules.free (R := R.over Y) (Fin m) ⟶
        ((CochainComplex.mappingCone φ).homology (k - 1)).over Y), Epi π) ∈ J X := by
  refine generate_of_local (local_approx f g hF φ X) (fun Y hY => ?_)
  obtain ⟨χ, hχ⟩ := hY
  have hCχ : IsStrictlyPerfect (CochainComplex.mappingCone χ) :=
    strictlyPerfect_cone (strictlyPerfect_over hF Y) (strictlyPerfect_over hP Y) χ
  have hk' : ∀ i, k ≤ i → (CochainComplex.mappingCone χ).ExactAt i := by
    intro i hi
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    obtain ⟨e⟩ := hχ i
    have h0 := (HomologicalComplex.exactAt_iff_isZero_homology _ _).1 (hex i hi)
    exact IsZero.of_iso (Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y) h0) e
  have hS := homology_finGen_locally (R := R.over Y) hCχ k hk' (Over.mk (𝟙 Y))
  have hS' := (GrothendieckTopology.mem_over_iff _ _).1 hS
  refine J.superset_covering ?_ hS'
  intro V v hv
  rw [Sieve.overEquiv_iff] at hv
  obtain ⟨W', a, b, ⟨m, π, hπ⟩, hab⟩ := hv
  obtain ⟨π', hπ'⟩ := exists_epi_free_transfer
    (M := (CochainComplex.mappingCone φ).homology (k - 1))
    (hχ (k - 1)).some W' m π hπ
  refine ⟨W'.left, a.left, b.left, ⟨m, π', hπ'⟩, ?_⟩
  have := congrArg (fun x => x.left) hab
  simpa using this


/-- Bounds for truncations. -/
private lemma truncGE_isStrictlyLE {A : Type*} [Category A] [Abelian A] (F : CochainComplex A ℤ)
    (a b : ℤ) [F.IsStrictlyLE b] : (F.truncGE a).IsStrictlyLE b := by
  rw [CochainComplex.isStrictlyLE_iff]
  intro i hi
  rcases lt_trichotomy i a with h | h | h
  · exact (F.truncGE a).isZero_of_isStrictlyGE a i h
  · subst h
    have hz : IsZero (F.X i) := F.isZero_of_isStrictlyLE b i hi
    exact IsZero.of_iso (IsZero.of_epi (F.pOpcycles i) hz) (F.truncGEXIsoOpcycles i)
  · exact IsZero.of_iso (F.isZero_of_isStrictlyLE b i hi) (F.truncGEXIso a i h)

/-- Terms of the truncation other than the `a`-th are finite free summands. -/
private lemma truncGE_fs {C' : Type} [SmallCategory C']
    {J' : GrothendieckTopology C'} [HasWeakSheafify J' AddCommGrpCat.{0}]
    [J'.WEqualsLocallyBijective AddCommGrpCat.{0}] {R' : Sheaf J' RingCat.{0}}
    (F : CochainComplex (Mod R') ℤ) (a : ℤ) (hF : ∀ i, IsFinFreeSummand (F.X i)) (n : ℤ)
    (hn : n ≠ a) : IsFinFreeSummand ((F.truncGE a).X n) := by
  rcases lt_or_gt_of_ne hn with h | h
  · exact ⟨0, 0, 0, ((F.truncGE a).isZero_of_isStrictlyGE a n h).eq_of_src _ _⟩
  · obtain ⟨m, i, p, hip⟩ := hF n
    let e := F.truncGEXIso a n h
    exact ⟨m, e.hom ≫ i, p ≫ e.inv, by
      rw [Category.assoc, ← Category.assoc i, hip, Category.id_comp, e.hom_inv_id]⟩

/-- The `a`-th term of the truncation of the restricted complex is the restricted
`opcycles`. -/
private noncomputable def truncOpcyclesIso [HasBinaryProducts C] (Y : C)
    (F : CochainComplex (Mod R) ℤ) (a : ℤ) :
    (((overC Y).obj F).truncGE a).X a ≅ (F.opcycles a).over Y :=
  ((overC Y).obj F).truncGEXIsoOpcycles a ≪≫
    ((F.sc a).mapOpcyclesIso (SheafOfModules.overFunctor.{0} R Y))

/-- The `(a-1)`-st term of the cone retracts onto the `a`-th term of the source. -/
private lemma coneX_retract {A : Type*} [Category A] [Abelian A] {τ Q : CochainComplex A ℤ}
    (χ : τ ⟶ Q) (a : ℤ) :
    ∃ (s : τ.X a ⟶ (CochainComplex.mappingCone χ).X (a - 2 + 1))
      (r : (CochainComplex.mappingCone χ).X (a - 2 + 1) ⟶ τ.X a), s ≫ r = 𝟙 _ := by
  let e : (CochainComplex.mappingCone χ).X (a - 2 + 1) ≅ τ.X (a - 2 + 1 + 1) ⊞ Q.X (a - 2 + 1) :=
    HomologicalComplex.homotopyCofiber.XIsoBiprod χ (a - 2 + 1) (a - 2 + 1 + 1) rfl
  let e' : τ.X (a - 2 + 1 + 1) ≅ τ.X a := τ.XIsoOfEq (by omega)
  refine ⟨e'.inv ≫ biprod.inl ≫ e.inv, e.hom ≫ biprod.fst ≫ e'.hom, ?_⟩
  simp only [Category.assoc, Iso.inv_hom_id_assoc, biprod.inl_fst_assoc, Iso.inv_hom_id]

/-- **Gen4.** The cokernel `F^a / d F^{a-1}` is locally a finite free summand, given a global
roof `K ← L → P` with `P` strictly perfect in `[a, b]`. -/
lemma opcycles_site [HasBinaryProducts C] {K L P F : CochainComplex (Mod R) ℤ}
    (f : L ⟶ K) (g : L ⟶ P) [QuasiIso f] [QuasiIso g] (hF : IsStrictlyPerfect F)
    (hP : IsStrictlyPerfect P) (a b : ℤ) [F.IsStrictlyLE b] [P.IsStrictlyGE a]
    [P.IsStrictlyLE b] (φ : F ⟶ K)
    (hex : ∀ i, a - 1 ≤ i → (CochainComplex.mappingCone φ).ExactAt i) (X : C) :
    Sieve.generate (fun Y (_ : Y ⟶ X) ↦ IsFinFreeSummand ((F.opcycles a).over Y)) ∈ J X := by
  refine generate_of_local (local_approx f g hF φ X) (fun Y hY => ?_)
  obtain ⟨χ, hχ⟩ := hY
  have hFY := strictlyPerfect_over hF Y
  have hPY := strictlyPerfect_over hP Y
  have hGE : ((overC Y).obj P).IsStrictlyGE a := by
    rw [CochainComplex.isStrictlyGE_iff]
    exact fun i hi => Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y)
      (P.isZero_of_isStrictlyGE a i hi)
  have hLE : ((overC Y).obj P).IsStrictlyLE b := by
    rw [CochainComplex.isStrictlyLE_iff]
    exact fun i hi => Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y)
      (P.isZero_of_isStrictlyLE b i hi)
  have hLEF : ((overC Y).obj F).IsStrictlyLE b := by
    rw [CochainComplex.isStrictlyLE_iff]
    exact fun i hi => Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y)
      (F.isZero_of_isStrictlyLE b i hi)
  have hexχ : ∀ i, a - 1 ≤ i → (CochainComplex.mappingCone χ).ExactAt i := by
    intro i hi
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    obtain ⟨e⟩ := hχ i
    have h0 := (HomologicalComplex.exactAt_iff_isZero_homology _ _).1 (hex i hi)
    exact IsZero.of_iso (Functor.map_isZero (SheafOfModules.overFunctor.{0} R Y) h0) e
  have hqχ : ∀ i, a ≤ i → QuasiIsoAt χ i := by
    intro i hi
    rw [quasiIsoAt_iff_isIso_homologyMap]
    have := cone_homology_epi χ i (hexχ i (by omega))
    have := cone_homology_mono χ i (hexχ (i - 1) (by omega))
    exact isIso_of_mono_of_epi _
  have hqτ : QuasiIso (CochainComplex.truncGEMap χ a) :=
    (CochainComplex.quasiIso_truncGEMap_iff χ a).2 hqχ
  have hπ : IsIso (((overC Y).obj P).πTruncGE a) := inferInstance
  let χb : ((overC Y).obj F).truncGE a ⟶ (overC Y).obj P :=
    CochainComplex.truncGEMap χ a ≫ inv (((overC Y).obj P).πTruncGE a)
  have hqb : QuasiIso χb := inferInstance
  have hD : (CochainComplex.mappingCone χb).Acyclic :=
    (quasiIso_iff_acyclic_mappingCone χb).1 hqb
  have hτLE := truncGE_isStrictlyLE ((overC Y).obj F) a b
  have hDGE : (CochainComplex.mappingCone χb).IsStrictlyGE (a - 2) := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    rw [CochainComplex.mappingCone.isZero_X_iff]
    exact ⟨((overC Y).obj F |>.truncGE a).isZero_of_isStrictlyGE a (i + 1) (by omega),
      ((overC Y).obj P).isZero_of_isStrictlyGE a i (by omega)⟩
  have hDLE : (CochainComplex.mappingCone χb).IsStrictlyLE b := by
    rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    rw [CochainComplex.mappingCone.isZero_X_iff]
    exact ⟨(((overC Y).obj F).truncGE a).isZero_of_isStrictlyLE b (i + 1) (by omega),
      ((overC Y).obj P).isZero_of_isStrictlyLE b i hi⟩
  have hfree : ∀ i, i ≠ a - 2 + 1 → IsFinFreeSummand ((CochainComplex.mappingCone χb).X i) := by
    intro i hi
    let e : (CochainComplex.mappingCone χb).X i ≅
        (((overC Y).obj F).truncGE a).X (i + 1) ⊞ ((overC Y).obj P).X i :=
      HomologicalComplex.homotopyCofiber.XIsoBiprod χb i (i + 1) rfl
    exact isFinFreeSummand_of_retract e.hom e.inv e.hom_inv_id
      (isFinFreeSummand_biprod (truncGE_fs _ a hFY.2 (i + 1) (by omega)) (hPY.2 i))
  have hS := isFinFreeSummand_locally_of_acyclic (R := R.over Y) (a - 2) b hD hfree
    (Over.mk (𝟙 Y))
  have hS' := (GrothendieckTopology.mem_over_iff _ _).1 hS
  refine J.superset_covering ?_ hS'
  intro V v hv
  rw [Sieve.overEquiv_iff] at hv
  obtain ⟨W', a', b', hW', hab⟩ := hv
  obtain ⟨s', r', hsr'⟩ := coneX_retract χb a
  let ιO := truncOpcyclesIso Y F a
  have hfs := isFinFreeSummand_transfer (M := F.opcycles a) (Y := Y)
    (N := (CochainComplex.mappingCone χb).X (a - 2 + 1)) (ιO.inv ≫ s') (r' ≫ ιO.hom)
    (by rw [Category.assoc, ← Category.assoc s', hsr', Category.id_comp, ιO.inv_hom_id]) W' hW'
  refine ⟨W'.left, a'.left, b'.left, hfs, ?_⟩
  have := congrArg (fun x => x.left) hab
  simpa using this

end Site

end Cohesive
